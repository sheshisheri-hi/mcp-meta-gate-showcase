# Shared HMAC secret for demo channel-policy attestations.
# This is a sample key. Never use it in production. No WebAuthn.
META_GATE_ATTESTATION_SECRET=demo-not-a-production-secret

# Issuer the MCP server gate trusts on attestations minted by the MCP host/client.
META_GATE_TRUSTED_ISSUER=mcp-host/demo
